# Actions AM8270 (RTD1195) SDK: Linux 3.10, buildroot 2014.05/2016.11 and
# the 32-bit arm-2013.11 kernel toolchain need an older host than 22.04:
#  - host gcc 7 still defaults to -fcommon (Linux 3.10 dtc defines yylloc twice)
#  - the i386 toolchain binaries need 32-bit libc, libstdc++ and zlib
#  - buildroot 2016.11 requires "python" (2.7)
#  - SDK scripts are bash scripts started with sh
FROM docker.io/library/ubuntu:18.04

LABEL io.container-tools.managed="true" \
      io.container-tools.recipe="ubuntu_1804_am8270"

ARG CONTAINER_TIMEZONE=Asia/Taipei
ARG DEBIAN_FRONTEND=noninteractive

# Fix timezone selection issue
RUN ln -snf /usr/share/zoneinfo/$CONTAINER_TIMEZONE /etc/localtime && echo $CONTAINER_TIMEZONE > /etc/timezone

# Install lists
RUN dpkg --add-architecture i386 && apt-get update && apt-get install -y sudo passwd util-linux setpriv \
	tzdata build-essential gcc-multilib g++-multilib lib32z1 lib32stdc++6 libc6-i386 \
	zlib1g-dev libncurses5-dev libssl1.0-dev flex bison gawk bc texinfo gettext intltool autoconf automake \
	libtool pkg-config patch perl tar cpio unzip zip xz-utils bzip2 lzop wget rsync file git \
	python python3 squashfs-tools e2fsprogs dosfstools mtd-utils device-tree-compiler \
	u-boot-tools fakeroot vim tree net-tools iputils-ping

# SDK and project scripts use bash syntax while being run as sh.
RUN ln -fs /bin/bash /bin/sh

# Initialize the mapped development account and container-local sudo permissions.
COPY tools/container_entrypoint.sh /usr/local/bin/container-tools-entrypoint
RUN chmod 755 /usr/local/bin/container-tools-entrypoint
ENTRYPOINT ["/usr/local/bin/container-tools-entrypoint"]
CMD ["/bin/bash"]

# Import Ubuntu image to Docker
FROM ubuntu:22.04

# Fix timezone selection issue
RUN ln -snf /usr/share/zoneinfo/$CONTAINER_TIMEZONE /etc/localtime && echo $CONTAINER_TIMEZONE > /etc/timezone

# Install lists
RUN apt-get update && apt-get install -y \
	build-essential clang flex bison g++ gawk \
	gettext git libncurses-dev libssl-dev \
	python3-distutils python3-setuptools rsync swig unzip zlib1g-dev file wget \
	tzdata cpio bc python3-setuptools swig python3-dev gettext git sudo apt-file \
    libncurses5-dev libncursesw5-dev libssl-dev python3 python3-distutils \
    rsync unzip zlib1g-dev pkg-config vim tree net-tools wireless-tools wget bison \
    uuid-dev meson mingw-w64 glslang-dev glslang-tools iputils-ping device-tree-compiler \
	gcc-aarch64-linux-gnu
#gcc-mipsel-linux-gnu gcc-aarch64-linux-gnu gcc-multilib g++-multilib

# Downloading and installing binary
RUN ln -fs /bin/bash /bin/sh
RUN ln -s /usr/bin/python3 /usr/bin/python

